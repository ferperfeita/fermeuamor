class QuietReportHandler(http.server.SimpleHTTPRequestHandler):
    def log_message(self, format, *args):
        return


def start_local_report_server(html_path):
    directory = os.path.dirname(os.path.abspath(html_path))
    filename = os.path.basename(html_path)
    handler = functools.partial(QuietReportHandler, directory=directory)
    last_error = None

    for port in range(8765, 8786):
        try:
            server = http.server.ThreadingHTTPServer(('127.0.0.1', port), handler)
            thread = threading.Thread(target=server.serve_forever, daemon=True)
            thread.start()
            url = 'http://localhost:{}/{}'.format(port, urllib.parse.quote(filename))
            opener = shutil.which('termux-open-url')
            if opener:
                subprocess.run([opener, url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
            return server, url
        except OSError as exc:
            last_error = exc
            continue
        except Exception as exc:
            return None, 'No se pudo iniciar el visor web local: {}'.format(exc)

    return None, 'No se encontró un puerto localhost disponible entre 8765 y 8785: {}'.format(last_error)


def _mask_identifier(value):
    raw = safe_text(value)
    if not raw:
        return raw
    digest = hashlib.sha256(raw.encode("utf-8", errors="ignore")).hexdigest()
    return "sha256:" + digest[:16]


def _sanitize_cloud_value(value, key=""):
    sensitive_keys = {
        "serial", "serialno", "imei", "imsi", "android_id", "advertising_id",
        "gaid", "meid", "mac", "wifi_mac", "bluetooth_mac", "bssid", "ssid",
        "token", "authorization", "password", "secret", "adbkey", "adb_keys",
    }
    key_l = safe_text(key).lower()
    if key_l in sensitive_keys or any(term in key_l for term in ["imei", "imsi", "serial", "token", "password", "secret"]):
        return _mask_identifier(value)
    if isinstance(value, dict):
        return {k: _sanitize_cloud_value(v, k) for k, v in value.items()}
    if isinstance(value, list):
        return [_sanitize_cloud_value(v, key) for v in value]
    if isinstance(value, str):
        cleaned = value.replace(HOME, "~")
        if len(cleaned) > 5000:
            cleaned = cleaned[:5000] + "\n...[TRUNCADO PARA REPORTE WEB]"
        return cleaned
    return value


def prepare_cloud_report(report, privacy="redacted"):
    data = copy.deepcopy(report)
    data["cloud_schema"] = "andreznss-report-v1"
    data["cloud_generated_at"] = datetime.now().isoformat()
    if privacy == "full":
        return data

    device = data.get("device_info", {})
    if isinstance(device, dict) and device.get("fingerprint"):
        device["fingerprint"] = _mask_identifier(device.get("fingerprint"))
    adb_status = safe_text(data.get("adb_status"))
    data["adb_status"] = "connected" if "\tdevice" in adb_status else "not_connected_or_unavailable"
    data.pop("rules_path", None)
    return _sanitize_cloud_value(data)


def publish_report(report):
    config = load_cloud_config()
    if not config.get("enabled") or not safe_text(config.get("api_url")):
        return {"enabled": False, "ok": False, "error": "API pública no configurada"}

    api_url = safe_text(config.get("api_url"))
    if not api_url.startswith("https://"):
        return {"enabled": True, "ok": False, "error": "La API debe usar HTTPS"}

    payload_obj = prepare_cloud_report(report, config.get("privacy", "redacted"))
    body = json.dumps(payload_obj, ensure_ascii=False, separators=(",", ":")).encode("utf-8")
    headers = {
        "Content-Type": "application/json; charset=utf-8",
        "Accept": "application/json",
        "User-Agent": "LocalReport",
        "X-AndreznSS-Schema": "andreznss-report-v1",
    }
    token = safe_text(config.get("token"))
    if token:
        headers["Authorization"] = "Bearer " + token

    request = urllib.request.Request(api_url, data=body, headers=headers, method="POST")
    try:
        with urllib.request.urlopen(request, timeout=int(config.get("timeout", 25))) as response:
            raw = response.read(1024 * 1024).decode("utf-8", errors="replace")
            status = getattr(response, "status", 200)
    except urllib.error.HTTPError as exc:
        detail = exc.read(4096).decode("utf-8", errors="replace") if hasattr(exc, "read") else ""
        return {"enabled": True, "ok": False, "error": f"HTTP {exc.code}: {detail[:300]}"}
    except Exception as exc:
        return {"enabled": True, "ok": False, "error": str(exc)}

    if status < 200 or status >= 300:
        return {"enabled": True, "ok": False, "error": f"HTTP {status}"}
    try:
        response_data = json.loads(raw) if raw.strip() else {}
    except Exception:
        return {"enabled": True, "ok": False, "error": "La API no devolvió JSON válido"}

    url = ""
    if isinstance(response_data, dict):
        for key in ["url", "report_url", "public_url", "link"]:
            candidate = safe_text(response_data.get(key))
            if candidate:
                url = candidate
                break
        if not url and response_data.get("id") and config.get("public_base_url"):
            url = safe_text(config.get("public_base_url")).rstrip("/") + "/" + urllib.parse.quote(safe_text(response_data.get("id")))
    if not url.startswith("https://"):
        return {"enabled": True, "ok": False, "error": "La respuesta no contiene una URL HTTPS pública", "response": response_data}
    return {"enabled": True, "ok": True, "url": url, "response": response_data}


def open_web_url(url):
    opener = shutil.which("termux-open-url")
    if opener and safe_text(url):
        subprocess.run([opener, url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)


def save_reports(report):
    ensure_dirs()
    timestamp = datetime.now().strftime("%Y-%m-%d_%H-%M-%S")
    base = f"{safe_filename(report['player_name'])}_{timestamp}"

    out_dir = DOWNLOAD_REPORT_DIR if os.path.exists(os.path.dirname(DOWNLOAD_REPORT_DIR)) else LOCAL_REPORT_DIR
    os.makedirs(out_dir, exist_ok=True)

    json_path = os.path.join(out_dir, base + ".json")
    txt_path = os.path.join(out_dir, base + ".txt")
    html_path = os.path.join(out_dir, base + ".html")

    with open(json_path, "w", encoding="utf-8") as f:
        json.dump(report, f, indent=2, ensure_ascii=False)
    write_txt_report(report, txt_path)
    generate_html_report(report, html_path)
    return txt_path, json_path, html_path


