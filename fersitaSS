def _normalized_snapshot_lines(text):
    """Normaliza snapshots sin borrar evidencia relevante."""
    lines = set()
    for raw in safe_text(text).splitlines():
        line = re.sub(r"\s+", " ", raw.strip())
        if line:
            lines.add(line)
    return lines


def _parse_socket_port_hits(lines, ports):
    port_set = {int(p) for p in ports}
    hits = []
    for line in lines:
        found = set()
        for match in re.finditer(r":(\d{1,5})(?:\s|$|\])", line):
            try:
                port = int(match.group(1))
            except Exception:
                continue
            if port in port_set:
                found.add(port)
        for port in sorted(found):
            hits.append({"port": port, "line": line[:320]})
    return hits


def _socket_is_public(line):
    lower = safe_text(line).lower()
    return any(token in lower for token in ["0.0.0.0:", "[::]:", ":::" ])


