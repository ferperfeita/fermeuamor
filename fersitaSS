            keyword_hits.append(hit)
            add_reason(reasons, points, f"Nombre de app con indicador sensible: {hit}", 4)

        if trust == "desconocido":
            add_reason(reasons, points, "Instalador no visible o desconocido", 3)
        elif trust == "instalador_manual_sistema":
            add_reason(reasons, points, "Instalada/actualizada mediante instalador manual del sistema", 4)
        elif trust == "tercero":
            add_reason(reasons, points, f"Instalador de tercero: {installer}", 2)
        else:
            reasons.append("Instalador aparentemente confiable/sistema; puede ser actualizacion automatica")

        change_type = "install_update" if recent_install and recent_update else "install" if recent_install else "update"
        risk = risk_from_points(max(points[0], 1))
        category = category_from_text(package, reasons)
