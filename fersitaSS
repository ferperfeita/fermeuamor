def scan_adb_live_delta(rules, baseline):
    """Compara logcat, procesos y sockets de inicio vs fin del análisis."""
    summary = {
        "baseline_captured": bool(baseline),
        "captured_at": baseline.get("captured_at") if baseline else None,
        "new_log_lines": 0,
        "suspicious_log_events": 0,
        "new_process_lines": 0,
        "suspicious_new_processes": 0,
        "new_socket_lines": 0,
        "suspicious_new_ports": 0,
    }
    if not baseline or not get_adb_connected_devices():
        return [], summary

    after_log = _normalized_snapshot_lines(
        adb_shell("logcat -d -v threadtime -t 3500", timeout=35)
    )
    after_processes = _normalized_snapshot_lines(
        adb_shell("ps -A -o USER,PID,PPID,NAME,ARGS 2>/dev/null || ps -A", timeout=18)
    )
    after_sockets = _normalized_snapshot_lines(
        adb_shell("ss -lntup 2>/dev/null || toybox netstat -lntup 2>/dev/null || netstat -lntup 2>/dev/null", timeout=18)
    )

    new_log = sorted(after_log - baseline.get("logcat", set()))
    new_processes = sorted(after_processes - baseline.get("processes", set()))
    new_sockets = sorted(after_sockets - baseline.get("sockets", set()))
    summary["new_log_lines"] = len(new_log)
    summary["new_process_lines"] = len(new_processes)
    summary["new_socket_lines"] = len(new_sockets)

    findings = []
    suspicious_log = []
    benign_terms = rules.get("benign_log_terms", [])
    for line in new_log:
        lower = line.lower()
        hits = sorted(set(contains_any(lower, rules.get("suspicious_log_keywords", []))))
        if not hits:
            continue
        # Evita el falso positivo típico de Samsung Camera/DeviceInjector.
        if contains_any(lower, benign_terms) and not any(
            strong in lower for strong in ["frida", "xposed", "lsposed", "gameguardian", "magisk", "zygisk"]
        ):
            continue
        suspicious_log.append({"line": line[:500], "hits": hits[:8]})

    if suspicious_log:
        strong_terms = ["frida", "xposed", "lsposed", "gameguardian", "ptrace", "zygisk", "magisk", "kernelsu", "apatch"]
        joined = " ".join(x["line"].lower() for x in suspicious_log)
        points = 18 if any(x in joined for x in strong_terms) else 9
        findings.append({
            "type": "live_event",
            "risk": risk_from_points(points),
            "risk_points": points,
            "confidence": confidence_from_points(points),
            "evidence_level": "fuerte_evento_en_vivo" if points >= 15 else "moderado",
            "category": "eventos_logcat_delta",
            "indicator": "new_suspicious_logcat_events",
            "value": suspicious_log[:25],
            "reasons": [
                "Se detectaron eventos nuevos con indicadores sensibles entre el inicio y el final del scan.",
                "Las líneas benignas conocidas de cámara Samsung fueron excluidas del resultado."
            ],
        })
    summary["suspicious_log_events"] = len(suspicious_log)

    suspicious_processes = []
    for line in new_processes:
        lower = line.lower()
        hits = sorted(set(contains_any(lower, rules.get("suspicious_process_keywords", []))))
        if hits:
            suspicious_processes.append({"line": line[:420], "hits": hits[:8]})
    if suspicious_processes:
        points = 22
        findings.append({
            "type": "process_delta",
            "risk": risk_from_points(points),
            "risk_points": points,
            "confidence": confidence_from_points(points),
            "evidence_level": "fuerte_proceso_nuevo",
            "category": "procesos_delta",
            "indicator": "new_suspicious_process_during_scan",
            "value": suspicious_processes[:25],
            "reasons": ["Apareció un proceso nuevo con nombre/argumentos sensibles durante el análisis."],
        })
    summary["suspicious_new_processes"] = len(suspicious_processes)

    port_hits = _parse_socket_port_hits(new_sockets, rules.get("suspicious_remote_ports", []))
    relevant_port_hits = []
    contextual_port_hits = []
    for item in port_hits:
        port = item.get("port")
        line = item.get("line", "")
        if port in [5037, 5555] and not _socket_is_public(line):
            contextual_port_hits.append(item)
        else:
            relevant_port_hits.append(item)
    if relevant_port_hits:
        strong_ports = {23946, 23947, 27042, 27043, 31337}
        points = 20 if any(x.get("port") in strong_ports for x in relevant_port_hits) else 11
        findings.append({
            "type": "network",
            "risk": risk_from_points(points),
            "risk_points": points,
            "confidence": confidence_from_points(points),
            "evidence_level": "fuerte_puerto_nuevo" if points >= 15 else "moderado",
            "category": "puertos_delta",
            "indicator": "new_suspicious_listening_port",
            "value": relevant_port_hits[:25],
            "reasons": ["Apareció un puerto sensible nuevo durante el scan."],
        })
    summary["suspicious_new_ports"] = len(relevant_port_hits)
    summary["contextual_adb_ports"] = len(contextual_port_hits)
    return findings, summary


