        "live_log_findings": sum(1 for x in actionable_findings if x.get("category") == "eventos_logcat_delta"),
        "live_process_findings": sum(1 for x in actionable_findings if x.get("category") == "procesos_delta"),
        "live_port_findings": sum(1 for x in actionable_findings if x.get("category") == "puertos_delta"),
        "categories": {},
    }
    for item in findings:
        cat = item.get("category", "general")
        summary["categories"][cat] = summary["categories"].get(cat, 0) + 1
    summary["verdict"] = verdict(summary)

    return {
        "scan_type": "post_match_adb" if use_adb else "post_match",
        "player_name": player,
        "scan_time": scan_time.isoformat(),
        "cutoff_time": cutoff_time.isoformat(),
        "window_hours": hours,
        "device_info": device_info,
        "dns_state": dns_state,
        "adb_status": adb_output(["devices"], timeout=8) if adb_available() else "adb_not_installed",
        "adb_remote_status": adb_remote_status,
        "reference_checks_status": reference_status,
        "replay_status": replay_status,
        "live_delta": live_delta_summary,
        "summary": summary,
        "findings": findings,
        "rules_path": RULES_PATH,
        "note": (
            "Reporte local de indicadores post-partida. No es prueba definitiva por si solo. "
            "Debe revisarse manualmente y aplicarse según el reglamento del torneo. "
            "El modo ADB usa comandos de solo lectura y no modifica archivos. "
