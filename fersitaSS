def risk_color(risk):
    risk = safe_text(risk).upper()
    if risk in ["CRITICO", "ALTO"]:
        return RED
    if risk == "MEDIO":
        return SCARLET
    if risk == "BAJO":
        return LIGHT_RED
    return GREEN


def short_value(value, limit=92):
    text = safe_text(value).replace("\n", " ")
    if len(text) <= limit:
        return text
    keep = max(10, (limit - 5) // 2)
    return text[:keep] + " ... " + text[-keep:]


def short_hash(value):
    text = safe_text(value)
    if not text:
        return "N/A"
    if len(text) <= 16:
        return text
    return text[:12] + "..." + text[-8:]


def simple_action_for(item):
    t = item.get("type")
    risk = safe_text(item.get("risk")).upper()
    if t == "network":
        if risk in ["CRITICO", "ALTO"]:
            return "Pedir al jugador mostrar VPN/DNS/proxy y desactivarlo antes de validar."
        return "Verificar si es VPN/DNS permitido por reglamento."
    if t == "integrity":
        return "Revisar root/bootloader/modulos con el juez; si el reglamento lo prohibe, retener validacion."
    if t == "hooking":
        return "Revisar si hay Xposed/LSPosed/Frida/hooking activo o instalado."
    if t == "adb":
        return "Pedir mostrar opciones de desarrollador y confirmar ADB/depuración."
    if t == "adb_remote":
        if risk == "NINGUNO":
            return "Dato contextual del propio modo ADB; no sancionar por este indicador."
        return "Revisar si ADB está expuesto fuera de localhost y cerrar el puerto antes de validar."
    if t == "live_event":
        return "Guardar la línea completa de logcat y correlacionarla con proceso, paquete y hora."
    if t == "process_delta":
        return "Identificar PID/paquete del proceso nuevo y confirmar si sigue activo."
    if t == "replay":
        return "Revisar ruta, hash y contenido del replay; las fechas aisladas no prueban manipulación."
    if t == "game_context":
        return "Revisar paquete, ruta, fecha y hash; no sancionar por timestamps o nombres genéricos sin corroboración."
    if t == "package":
        if item.get("recent_install") or item.get("recent_update"):
            return "Abrir ajustes de la app y confirmar instalacion/actualizacion reciente."
        return "Revisar si la app esta permitida por el reglamento."
    if t == "app_change":
        if item.get("recent_install"):
            return "Confirmar con el jugador por que la app fue instalada dentro de la ventana post-partida."
        if item.get("recent_update"):
            return "Confirmar si fue actualizacion automatica de tienda o cambio manual reciente."
        return "Revisar cambio reciente de app."
    if t == "file":
        if item.get("recently_modified"):
            return "Abrir ruta del archivo y validar fecha/contenido con el juez."
        return "Revisar manualmente el archivo; puede ser antiguo o falso positivo."
    return "Revisar manualmente."


def print_simple_findings(report, limit=TERMUX_FINDING_LIMIT):
    findings = report.get("findings", [])
    print("\n" + "=" * 62)
    print(f"{WHITE}HALLAZGOS Y OBSERVACIONES EN TERMUX{RESET}")
    print("=" * 62)

    if not findings:
        print(f"{GREEN}[OK]{RESET} No se encontraron indicadores sospechosos con las reglas actuales.")
        return

    print(f"Mostrando {min(limit, len(findings))} de {len(findings)} elementos. El detalle completo queda en el TXT/JSON.\n")

    for index, item in enumerate(findings[:limit], start=1):
        risk = safe_text(item.get("risk", "N/A"))
        color = risk_color(risk)
        points = item.get("risk_points", 0)
        item_type = item.get("type", "unknown")
        print(f"{color}[{index}] {risk} | {points} pts | {item_type.upper()} | {item.get('category','general')} | confianza: {item.get('confidence','N/A')}{RESET}")

        if item_type == "file":
            print(f"    Archivo : {short_value(item.get('filename'), 70)}")
            print(f"    Ruta    : {short_value(item.get('path'), 96)}")
            print(f"    Fecha   : {item.get('modified_time') or 'N/A'} | Reciente: {item.get('recently_modified')}")
            print(f"    SHA256  : {short_hash(item.get('sha256'))}")
        elif item_type == "package":
            print(f"    Paquete : {short_value(item.get('package'), 90)}")
            print(f"    Version : {item.get('version_name') or 'N/A'}")
            print(f"    Installer: {item.get('installer') or 'N/A'}")
            print(f"    Instalo : {item.get('first_install_time') or 'N/A'} | Reciente: {item.get('recent_install')}")
            print(f"    Update  : {item.get('last_update_time') or 'N/A'} | Reciente: {item.get('recent_update')}")
        elif item_type == "app_change":
            print(f"    Paquete : {short_value(item.get('package'), 90)}")
            print(f"    Version : {item.get('version_name') or 'N/A'}")
            print(f"    Installer: {item.get('installer') or 'N/A'}")
            print(f"    Instalo : {item.get('first_install_time') or 'N/A'} | Reciente: {item.get('recent_install')}")
            print(f"    Update  : {item.get('last_update_time') or 'N/A'} | Reciente: {item.get('recent_update')}")
            print(f"    Cambio  : {item.get('change_type') or 'N/A'}")
        elif item_type == "network":
            print(f"    Indicador: {short_value(item.get('indicator'), 90)}")
            print(f"    Valor    : {short_value(item.get('value'), 96)}")
        elif item_type == "device_flag":
            print(f"    Indicador: {short_value(item.get('indicator'), 90)}")
            print(f"    Valor    : {short_value(item.get('value'), 96)}")
        elif item_type in ["integrity", "hooking", "adb", "adb_remote", "live_event", "process_delta", "replay", "game_context"]:
            print(f"    Indicador: {short_value(item.get('indicator'), 90)}")
            print(f"    Valor    : {short_value(item.get('value'), 96)}")
        else:
            print(f"    Dato: {short_value(item, 96)}")

        reasons = item.get("reasons", [])[:3]
        if reasons:
            print("    Motivos :")
            for reason in reasons:
                print(f"      - {short_value(reason, 96)}")

        print(f"    Accion  : {simple_action_for(item)}")
        print()

    remaining = len(findings) - limit
    if remaining > 0:
        print(f"{SCARLET}[*]{RESET} Hay {remaining} hallazgos mas. Revisa el reporte TXT para verlos todos.")


