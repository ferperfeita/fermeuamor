            "risk_points": points,
            "confidence": confidence_from_points(points),
            "evidence_level": "moderado",
            "category": "root_integridad",
            "indicator": "android_integrity_props",
            "value": suspicious_props,
            "reasons": ["Propiedades de Android asociadas a bootloader/root/debug detectadas"],
        })

    # Paquetes de root visibles, incluso si no son de usuario.
    all_packages = get_all_packages()
    root_pkg_hits = []
