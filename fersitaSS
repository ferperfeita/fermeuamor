def _epoch_to_iso(value):
    try:
        return datetime.fromtimestamp(float(value)).isoformat()
    except Exception:
        return None


def _parse_stat_line(line):
    line = safe_text(line)
    if not line or "|" not in line:
        return None
    parts = line.rsplit("|", 3)
    if len(parts) != 4:
        return None
    path, atime, mtime, ctime = parts
    try:
        return {
            "path": path,
            "atime_epoch": float(atime),
            "mtime_epoch": float(mtime),
            "ctime_epoch": float(ctime),
            "atime": _epoch_to_iso(atime),
            "mtime": _epoch_to_iso(mtime),
            "ctime": _epoch_to_iso(ctime),
        }
    except Exception:
        return None


def _package_install_update_times_adb(package):
    dump = adb_shell(
        f"dumpsys package {shlex.quote(package)} | grep -E 'firstInstallTime=|lastUpdateTime='",
        timeout=12,
    )
    return {
        "first_install": parse_time_from_dumpsys(dump, "firstInstallTime"),
        "last_update": parse_time_from_dumpsys(dump, "lastUpdateTime"),
        "raw": dump,
    }


def _discover_replay_paths_adb(package):
    if not re.fullmatch(r"[A-Za-z0-9._]+", safe_text(package)):
        return []
    roots = [
        f"/sdcard/Android/data/{package}/files",
        f"/storage/emulated/0/Android/data/{package}/files",
    ]
    discovered = []
    for root in roots:
        qroot = shlex.quote(root)
        output = adb_shell(
            f"find {qroot} -maxdepth 7 \\( -type d -o -type f \\) "
            f"\\( -iname '*mreplay*' -o -iname '*replay*' \\) -print 2>/dev/null | head -n 40",
            timeout=25,
        )
        discovered.extend(x.strip() for x in output.splitlines() if x.strip())
        for dirname in ["MReplays", "MREPLAYS", "mreplays", "Replays", "replays"]:
            exact = f"{root}/{dirname}"
            exists = adb_shell(f"test -e {shlex.quote(exact)} && echo EXISTS", timeout=6)
            if "EXISTS" in exists:
                discovered.append(exact)
    return sorted(set(discovered))[:40]


def _stat_replay_tree_adb(root_path):
    qroot = shlex.quote(root_path)
    paths_out = adb_shell(
        f"(echo {qroot}; find {qroot} -maxdepth 2 -print 2>/dev/null) | head -n 100",
        timeout=22,
    )
    records = []
    seen = set()
    for path in paths_out.splitlines():
        path = path.strip()
        if not path or path in seen:
            continue
        seen.add(path)
        stat_out = adb_shell(
            f"stat -c '%n|%X|%Y|%Z' {shlex.quote(path)} 2>/dev/null",
            timeout=8,
        )
        for line in stat_out.splitlines():
            parsed = _parse_stat_line(line)
            if parsed:
                records.append(parsed)
    return records


def scan_replay_timestamps_adb(rules, cutoff_time):
    """Analiza MReplays sin afirmar que una diferencia de fechas sea un cheat."""
    status = {
        "available": False,
        "packages_checked": [],
        "replay_paths_found": 0,
        "records_checked": 0,
        "anomaly_count": 0,
        "result": "NO_EJECUTADO",
    }
    if not adb_available() or not get_adb_connected_devices():
        return [], status

    status["available"] = True
    findings = []
    now = datetime.now()
    packages = rules.get("free_fire_packages", ["com.dts.freefireth", "com.dts.freefiremax"])
    for package in packages:
        if not re.fullmatch(r"[A-Za-z0-9._]+", safe_text(package)):
            continue
        installed = adb_shell(f"pm path {shlex.quote(package)}", timeout=8)
        if not installed.startswith("package:"):
            continue
        status["packages_checked"].append(package)
        package_times = _package_install_update_times_adb(package)
        first_install = package_times.get("first_install")
        last_update = package_times.get("last_update")
        roots = _discover_replay_paths_adb(package)
        status["replay_paths_found"] += len(roots)
        all_records = []
        for root in roots:
            all_records.extend(_stat_replay_tree_adb(root))
        # Deduplica rutas repetidas por /sdcard y /storage/emulated/0.
        unique = {}
        for record in all_records:
            normalized_path = record["path"].replace("/storage/emulated/0", "/sdcard")
            unique[normalized_path] = record
        records = list(unique.values())
        status["records_checked"] += len(records)
        if not records:
            continue

        reasons = []
        points = 0
        future_items = []
        preinstall_items = []
        access_gap_items = []
        recent_records = []
        for record in records:
            mdt = datetime.fromtimestamp(record["mtime_epoch"])
            cdt = datetime.fromtimestamp(record["ctime_epoch"])
            adt = datetime.fromtimestamp(record["atime_epoch"])
            if mdt >= cutoff_time or cdt >= cutoff_time:
                recent_records.append(record)
            if mdt > now + timedelta(minutes=5) or cdt > now + timedelta(minutes=5):
                future_items.append(record)
            if first_install and (mdt < first_install - timedelta(minutes=5) or cdt < first_install - timedelta(minutes=5)):
                preinstall_items.append(record)
            if (mdt - adt) > timedelta(hours=24) and mdt >= cutoff_time:
                access_gap_items.append(record)

        if future_items:
            points += 18
            reasons.append("Hay timestamps de replay más de 5 minutos en el futuro respecto al reloj del dispositivo.")
        if preinstall_items:
            points += 7
            reasons.append("Hay archivos/carpetas de replay con tiempos anteriores a la instalación registrada de Free Fire; puede ser restauración o copia.")
        if access_gap_items:
            points += 3
            reasons.append("Se observó acceso antiguo con modificación reciente en elementos de replay; es contextual y no concluyente.")

        # Detecta modificaciones sincronizadas, típico de copia/extracción masiva, pero no exclusivo de cheats.
        recent_mtimes = sorted(int(x["mtime_epoch"]) for x in recent_records)
        synchronized = 0
        for i, value in enumerate(recent_mtimes):
            group = [x for x in recent_mtimes if abs(x - value) <= 2]
            synchronized = max(synchronized, len(group))
        if synchronized >= 3:
            points += 6
            reasons.append(f"Se detectaron {synchronized} elementos de replay modificados casi al mismo segundo; posible copia/extracción masiva.")

        points = min(points, 20)
        context = {
            "package": package,
            "first_install_time": first_install.isoformat() if first_install else None,
            "last_update_time": last_update.isoformat() if last_update else None,
            "replay_roots": roots,
            "records_checked": len(records),
            "recent_records": len(recent_records),
            "future_records": len(future_items),
            "preinstall_records": len(preinstall_items),
            "old_access_recent_modify_records": len(access_gap_items),
            "synchronized_recent_records": synchronized,
            "sample": records[:20],
        }

        if points > 0:
            status["anomaly_count"] += 1
            findings.append({
                "type": "replay",
                "risk": risk_from_points(points),
                "risk_points": points,
                "confidence": confidence_from_points(points),
                "evidence_level": "moderado_timestamps",
                "category": "replay_integridad",
                "indicator": "replay_timestamp_anomaly",
                "value": context,
                "reasons": reasons + [
                    "Los metadatos temporales por sí solos no prueban un 'pasador de replay'; requieren revisión manual del archivo y su hash."
                ],
            })
        else:
            findings.append({
                "type": "replay",
                "risk": "NINGUNO",
                "risk_points": 0,
                "confidence": "MEDIA",
                "evidence_level": "contexto_sin_anomalia",
                "category": "replay_integridad",
                "indicator": "replay_timestamps_no_material_anomaly",
                "value": context,
                "reasons": ["Se encontraron datos de replay, pero no una anomalía temporal material con las reglas actuales."],
            })

    if not status["packages_checked"]:
        status["result"] = "FREE_FIRE_NO_DETECTADO"
    elif status["replay_paths_found"] == 0:
        status["result"] = "SIN_RUTA_REPLAY_ACCESIBLE"
    elif status["anomaly_count"] > 0:
        status["result"] = "ANOMALIA_CONTEXTUAL"
    else:
        status["result"] = "SIN_ANOMALIA_MATERIAL"
    return findings, status


def _adb_path_records(paths, limit=100):
    """Obtiene stat de rutas ADB sin modificar archivos."""
    records = []
    seen = set()
    for path in paths[:limit]:
        path = safe_text(path).strip()
        if not path or path in seen:
            continue
        seen.add(path)
        stat_out = adb_shell(
            f"stat -c '%n|%X|%Y|%Z' {shlex.quote(path)} 2>/dev/null",
            timeout=8,
        )
        for line in stat_out.splitlines():
            parsed = _parse_stat_line(line)
            if parsed:
                records.append(parsed)
    return records


