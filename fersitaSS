def verdict(summary):
    if summary["critical_risk"] > 0 or summary["network_high"] > 0:
        return "REVISION_URGENTE"
    if summary["high_risk"] > 0 or summary["recent_suspicious_files"] > 0:
        return "REVISION_MANUAL"
    if summary["medium_risk"] > 0 or summary["network_findings"] > 0:
        return "OBSERVAR"
    if summary["low_risk"] > 0:
        return "OBSERVAR_BAJO"
    return "SIN_INDICADORES"


