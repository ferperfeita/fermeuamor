            "risk_points": points,
            "indicator": "private_dns_custom_strict",
            "value": {"mode": mode, "specifier": specifier, "default_mode": default_mode, "validated_server": validated},
            "reasons": reasons,
        })
    elif specifier:
        points = 9
        reasons = ["Servidor DNS privado especificado aunque el modo no sea estricto"]
        findings.append({
            "type": "network",
            "risk": risk_from_points(points),
            "risk_points": points,
            "indicator": "private_dns_specifier_present",
            "value": {"mode": mode, "specifier": specifier},
            "reasons": reasons,
        })

    dns_terms = contains_any(f"{specifier} {validated}", rules.get("dns_suspicious_terms", []))
    if dns_terms:
        points = 11
        findings.append({
            "type": "network",
            "risk": risk_from_points(points),
            "risk_points": points,
            "indicator": "known_custom_dns_provider",
            "value": {"hits": sorted(set(dns_terms)), "specifier": specifier, "validated_server": validated},
            "reasons": ["Proveedor DNS personalizado detectado; puede ser legitimo, pero debe estar permitido por reglamento"],
        })

    # Valores de resolver alterados rara vez importan para usuarios normales; se registran si hay algo no vacio.
    resolver_keys = [k for k in state.keys() if k.startswith("dns_resolver_") and safe_text(state.get(k))]
    if resolver_keys:
        findings.append({
            "type": "network",
            "risk": "BAJO",
            "risk_points": 4,
            "indicator": "dns_resolver_global_settings_present",
            "value": {k: state.get(k) for k in resolver_keys},
            "reasons": ["Configuraciones globales del resolver DNS presentes. Indicador contextual, no prueba de trampa."],
        })

    for item in findings:
        item.setdefault("category", "dns_modificado")
        item.setdefault("confidence", confidence_from_points(item.get("risk_points", 0)))
        item.setdefault("evidence_level", evidence_level(item.get("risk"), network=True))

    return findings, state


def parse_ports_from_text(text, proxy_ports):
    hits = []
    port_set = {int(p) for p in proxy_ports}
    for line in text.splitlines():
        clean = line.strip()
        for match in re.finditer(r":(\d{1,5})\b", clean):
            try:
                port = int(match.group(1))
            except Exception:
                continue
            if port in port_set:
                hits.append({"port": port, "line": clean[:300]})
    return hits


def scan_network_indicators(rules):
    findings = []
    proxy_ports = rules.get("proxy_ports", [])

    # Android HTTP proxy global.
    http_proxy = read_setting("global", "http_proxy")
    global_proxy_host = read_setting("global", "global_http_proxy_host")
    global_proxy_port = read_setting("global", "global_http_proxy_port")
    if http_proxy and http_proxy.lower() not in ["null", "undefined", ":0"]:
        findings.append({
            "type": "network",
            "risk": "ALTO",
            "risk_points": 15,
            "indicator": "android_http_proxy",
            "value": http_proxy,
            "reasons": ["Proxy HTTP global configurado en Android"],
        })
    if global_proxy_host and global_proxy_host.lower() not in ["null", "undefined", ""]:
        findings.append({
            "type": "network",
            "risk": "ALTO",
            "risk_points": 15,
            "indicator": "global_http_proxy_host",
            "value": f"{global_proxy_host}:{global_proxy_port}",
            "reasons": ["Host/puerto de proxy global detectado"],
        })

    # DNS privado y ajustes relacionados.
    dns_findings, _dns_state = scan_dns_indicators(rules)
    findings.extend(dns_findings)

    # Interfaces VPN/túneles.
    ip_output = run_command(["ip", "addr", "show"], timeout=6) if command_exists("ip") else ""
    if not ip_output:
        ip_output = run_command(["ifconfig"], timeout=6) if command_exists("ifconfig") else ""
    tunnel_names = []
    for line in ip_output.splitlines():
        line_clean = line.strip().lower()
        if re.search(r"\b(tun\d*|tap\d*|wg\d*|ppp\d*|utun\d*)\b", line_clean):
            tunnel_names.append(line.strip()[:250])
    if tunnel_names:
        findings.append({
            "type": "network",
            "risk": "ALTO",
            "risk_points": 17,
            "indicator": "vpn_tunnel_interface",
            "value": tunnel_names,
            "reasons": ["Interfaz tipo VPN/tunel detectada: tun/tap/wg/ppp"],
        })

    # Puertos locales comunes de proxy.
    socket_text = ""
    if command_exists("ss"):
        socket_text = run_command(["ss", "-lntup"], timeout=6)
    if not socket_text and command_exists("netstat"):
        socket_text = run_command(["netstat", "-lntp"], timeout=6)
    port_hits = parse_ports_from_text(socket_text, proxy_ports) if socket_text else []
    if port_hits:
        findings.append({
            "type": "network",
            "risk": "MEDIO",
            "risk_points": 10,
            "indicator": "local_proxy_like_ports",
            "value": port_hits[:20],
            "reasons": ["Puertos locales comunes de proxy/tunel detectados"],
        })

    for item in findings:
        item.setdefault("category", "red_proxy_vpn")
        item.setdefault("confidence", confidence_from_points(item.get("risk_points", 0)))
        item.setdefault("evidence_level", evidence_level(item.get("risk"), network=True))

    return findings



